# ==============================================================================
# LegacyVault Backend - Environment Configuration Template
# ==============================================================================

# Application Environment & Server
PORT=5000
NODE_ENV=production

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
# Option A: Full Connection URL (Recommended for Neon, Supabase, Render, Railway, AWS RDS)
# DATABASE_URL=postgres://user:password@host.region.rds.amazonaws.com:5432/legacyvault

# Option B: Individual Connection Parameters
DB_HOST=localhost
DB_PORT=5432
DB_NAME=legacyvault
DB_USER=postgres
DB_PASSWORD=your_secure_db_password

# Database Connection Pooling (Prevent overwhelming DB with connections under high traffic)
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000
DB_POOL_EVICT=1000

# SSL / TLS Settings for Cloud Databases (Neon, Supabase, AWS RDS require true)
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

# ------------------------------------------------------------------------------
# Distributed Caching & Rate Limiting (Redis)
# ------------------------------------------------------------------------------
# Local Docker: redis://localhost:6379
# Upstash Serverless Redis: rediss://default:yourpassword@your-endpoint.upstash.io:6379
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# Cryptographic & Security Secrets (Generate using: openssl rand -hex 32)
# ------------------------------------------------------------------------------
# Secret for signing access tokens (Required)
JWT_SECRET=generate_strong_random_secret_with_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRES_IN=15m

# HMAC Secret for Audit Log tamper-proof hash chain (Required in prod)
AUDIT_LOG_SECRET=generate_strong_random_secret_with_openssl_rand_hex_32

# AES-256-GCM Vault Encryption Key (64 hex characters = 32 bytes)
VAULT_ENCRYPTION_KEY=generate_64_hex_chars_using_openssl_rand_hex_32

# Multi-version key rotation keyring (Optional, JSON format)
# VAULT_KEYS={"v1":"64_hex_chars...","v2":"64_hex_chars..."}
# PRIMARY_KEY_VERSION=v1

# ------------------------------------------------------------------------------
# Frontend & CORS Configuration
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (no trailing slashes)
FRONTEND_URL=https://your-frontend.vercel.app,https://yourdomain.com

# Cookie SameSite setting ('none' for cross-domain HTTPS, 'lax' or 'strict' for same-domain)
COOKIE_SAME_SITE=none

# ------------------------------------------------------------------------------
# Email Service (SMTP for Password Reset)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
EMAIL_FROM="LegacyVault <no-reply@yourdomain.com>"